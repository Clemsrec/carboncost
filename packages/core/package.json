{
  "name": "carbone-cost",
  "version": "0.9.1",
  "description": "Core estimation and methodology utilities for Carbon Site Kit.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/badge": {
      "types": "./dist/react/badge.d.ts",
      "import": "./dist/react/badge.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clemsrec/carboncost.git"
  },
  "bugs": {
    "url": "https://github.com/Clemsrec/carboncost/issues"
  },
  "homepage": "https://github.com/Clemsrec/carboncost#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && node --test dist-test/estimation.test.js dist-test/diagnostics.test.js dist-test/browser/classify.test.js dist-test/browser/collector.test.js dist-test/react/store.test.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0"
  }
}
