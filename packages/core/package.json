    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clemsrec/carboncost.git"
  },
  "bugs": {
    "url": "https://github.com/Clemsrec/carboncost/issues"
  },
  "homepage": "https://github.com/Clemsrec/carboncost#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/estimation.test.js"
  }
