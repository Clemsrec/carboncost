{
  "name": "@clemsrec/next",
  "version": "0.1.0",
  "description": "Next.js adapter for Carbon Site Kit.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clemsrec/carboncost.git"
  },
  "bugs": {
    "url": "https://github.com/Clemsrec/carboncost/issues"
  },
  "homepage": "https://github.com/Clemsrec/carboncost#readme",
  "dependencies": {
    "carbone-cost": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  }
}
